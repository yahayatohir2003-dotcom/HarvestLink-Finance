# ==============================================================================
# HarvestLink Finance - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.local' and populate with your Supabase project credentials.
# Note: Never commit your actual '.env' or '.env.local' file to version control.
# ==============================================================================

# Supabase Project URL
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key
# Safe for use in browser/client applications with Row Level Security (RLS) enabled.
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (SERVER-ONLY - CRITICAL SECURITY)
# WARNING: NEVER expose this key to client-side code, browser bundles, or public repositories.
# This key bypasses Row Level Security (RLS) and is strictly reserved for trusted server routines.
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys (service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Application Base URL
# Used for authentication redirect URLs (email verification, password reset callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Storage Bucket Configuration
# Pre-existing bucket name specified for document management
NEXT_PUBLIC_STORAGE_BUCKET=transaction-documents
